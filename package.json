{
	"name": "@depthbomb/serde",
	"version": "2.0.1",
	"description": "Type-safe JSON ↔ Class serialization for TypeScript",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"keywords": [
		"typescript",
		"serialization",
		"deserialization",
		"utilities"
	],
	"exports": {
		".": "./dist/index.mjs",
		"./errors": "./dist/errors.mjs",
		"./utilities": "./dist/utilities.mjs"
	},
	"types": "./dist/index.d.mts",
	"files": [
		"dist"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/depthbomb/serde.git"
	},
	"bugs": {
		"url": "https://github.com/depthbomb/serde/issues"
	},
	"scripts": {
		"build": "tsc --noEmit",
		"typecheck:test": "tsc -p tsconfig.test.json",
		"dist": "tsdown",
		"release": "yarn dist && release-it",
		"lint": "oxlint ./src",
		"test:unit": "vitest run",
		"test:package": "yarn dist && node test/package-smoke.mjs",
		"bench": "yarn dist && node bench/serde.mjs",
		"test": "yarn test:unit",
		"check": "yarn build && yarn typecheck:test && yarn lint && yarn test && yarn test:package"
	},
	"devDependencies": {
		"@types/node": "^24.19.1",
		"oxlint": "^1.86.0",
		"oxlint-tsgolint": "^7.0.2003",
		"release-it": "^21.1.0",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"packageManager": "yarn@4.18.1",
	"resolutions": {
		"get-uri/basic-ftp": "6.2.1",
		"release-it/undici": "7.30.0"
	}
}
